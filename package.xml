<?xml version="1.0" encoding="UTF-8" standalone="no" ?>
<package format="1" xmlns="https://wiki.freecad.org/Package_Metadata">
  <name>CoBench</name>
  <description>Work on a FreeCAD project with other people: lock a part while you edit it, see who works on what in a list with previews or directly in the assembly. Works with any shared or synchronised folder (network share, Nextcloud, Dropbox, Google Drive, Syncthing...).</description>
  <version>0.3.0</version>
  <date>2026-11-02</date>
  <maintainer email="LMGerard@users.noreply.github.com">LMGerard</maintainer>
  <author>LMGerard</author>
  <license file="LICENSE">LGPL-2.1-or-later</license>
  <url type="repository" branch="main">https://github.com/LMGerard/CoBench</url>
  <url type="bugtracker">https://github.com/LMGerard/CoBench/issues</url>
  <url type="readme">https://github.com/LMGerard/CoBench/blob/main/README.md</url>
  <icon>Resources/icons/CoBench.svg</icon>
  <content>
    <workbench>
      <name>CoBench</name>
      <classname>CoBenchWorkbench</classname>
      <subdirectory>./</subdirectory>
      <freecadmin>1.0.0</freecadmin>
      <tag>collaboration</tag>
      <tag>lock</tag>
      <tag>project</tag>
      <tag>assembly</tag>
      <tag>PDM</tag>
    </workbench>
  </content>
</package>
